APP_NAME="IT Activity Tracker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Africa/Accra

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=it_activity
DB_USERNAME=it_activity
DB_PASSWORD=it_activity_change_me

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Optional Docker Compose project name (copy to host .env if needed)
COMPOSE_PROJECT_NAME=it-activity-tracker

# Docker network name used by all application services
DOCKER_NETWORK_NAME=it-activity-tracker-network
